{
  "name": "pi-harness",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --external:esbuild --external:@earendil-works/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
