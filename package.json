{
  "name": "a-factory",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action: an issue opens an exe.dev VM running opencode, seeded with the issue; questions on the issue resume the same session; finishes with a branch and PR.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@opencode-ai/sdk": "^1.18.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
